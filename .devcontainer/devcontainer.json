{
  "name": "VEX Robotics",
  "image": "vex-comp:1.0.0",
  "runArgs": [
    "--name",
    "vex-robotics"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools",
        "marus25.cortex-debug"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/usr/bin/arm-none-eabi-gcc"
      }
    }
  },
  "workspaceFolder": "/workspace",
  "remoteUser": "root"
}